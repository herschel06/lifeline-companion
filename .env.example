# Apps Script web app /exec URL that appends rows to the waitlist Google Sheet.
# See scripts/google-sheet-waitlist.gs for setup steps.
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional. Must match SHARED_SECRET in the Apps Script if you set one there.
GOOGLE_SHEETS_SHARED_SECRET=

# Absolute origin used for canonical + Open Graph URLs, e.g. https://spara.app
NEXT_PUBLIC_SITE_URL=
